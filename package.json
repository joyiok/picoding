{
  "name": "picoding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-isolation=none --test test/*.test.ts",
    "verify": "npm test && npm run build",
    "test:integration": "npm run build && node --import tsx scripts/verify-sandbox.ts",
    "sandbox:build": "node --import tsx scripts/build-sandbox.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "pi:packages": "node --import tsx scripts/pi-packages.ts",
    "test:access": "npm run build && node --import tsx scripts/verify-access.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "8.0.4",
    "playwright-core": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.14.5",
    "tsx": "4.22.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
