# Private, single-workspace control server. No secrets are sent to the task container.
PICODING_HOST=127.0.0.1
PICODING_PORT=4310
# 远程部署：在 HTTPS 反向代理后运行，并同时填写以下两项。
# 访问密码 12–256 字符，建议随机生成。仅本机访问时可不启用。
# PICODING_PUBLIC_ORIGIN=https://coding.example.com
# PICODING_ACCESS_PASSWORD=
## 可选：任务环境的 HTTP/HTTPS 代理；默认继承后端环境中的代理设置。
## localhost 代理通过专用转发容器接入。填 none 禁用任务环境代理。
# PICODING_SANDBOX_PROXY=http://127.0.0.1:7890
PICODING_DATA_DIR=.picoding
PICODING_SANDBOX_IMAGE=picoding-sandbox:local
# 可选：覆盖镜像构建网络。Linux 使用本机环回代理时会自动选择 host。
# PICODING_BUILD_NETWORK=host
PICODING_MAX_TASKS=3
PICODING_SANDBOX_MEMORY=2g
PICODING_SANDBOX_CPUS=2
# Optional: use Web settings or supply your own API format, endpoint and model.
# 模型请求默认继承 HTTP(S)_PROXY；可单独覆盖，填 none 禁用。任务电脑代理独立配置。
# PICODING_MODEL_PROXY=http://127.0.0.1:7890
# PICODING_API_PROTOCOL=openai
# PICODING_API_BASE_URL=
# PICODING_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
